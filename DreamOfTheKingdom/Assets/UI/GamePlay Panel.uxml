                <ui:Label text="3" name="EnergyAmount" double-click-selects-word="false" picking-mode="Ignore" triple-click-selects-line="false" display-tooltip-when-elided="false" style="-unity-text-align: middle-right; color: rgb(92, 234, 249); font-size: 50px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); right: 22px; -unity-font-style: bold-and-italic; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 249, 249);" />
            </ui:VisualElement>
            <ui:VisualElement name="DrawDeck" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_handcards.png?fileID=2800000&amp;guid=3388a6609e5f941f7bfb3fb2a8e419ac&amp;type=3#btn_handcards&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; width: 128px; height: 128px;">
                <ui:Label text="3" name="DrawAmount" picking-mode="Ignore" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="-unity-text-align: middle-right; color: rgb(117, 199, 104); font-size: 50px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); right: 22px; -unity-font-style: bold-and-italic; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 249, 249);" />
            </ui:VisualElement>
            <ui:VisualElement name="DiscardDeck" picking-mode="Ignore" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI%20Elements/btn_discard.png?fileID=2800000&amp;guid=1afe153a33a5f490fb3daa334057b3f5&amp;type=3#btn_discard&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: center; width: 128px; height: 128px;">
                <ui:Label text="3" name="DiscardAmount" picking-mode="Ignore" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="-unity-text-align: middle-right; color: rgb(254, 140, 165); font-size: 50px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); right: 22px; -unity-font-style: bold-and-italic; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(255, 249, 249);" />
